      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-url\">Endereço do artigo</label><p class=\"ds-hint\" id=\"ds-help\">Use um link público que comece com https:// ou http://.</p><input class=\"ds-input\" id=\"ds-url\" type=\"url\" required pattern=\"https?://.*\" placeholder=\"https://exemplo.com/artigo\" aria-describedby=\"ds-help\"></div>",
      "css": ".ds-field { color: #182f3b; font: 1rem/1.6 system-ui, sans-serif; } .ds-label { display: block; font-weight: 600; margin-block-end: .4rem; } .ds-hint { color: #48616a; font-size: .875rem; margin: 0 0 .75rem; } .ds-input { display: block; inline-size: 100%; min-inline-size: 0; min-block-size: 3rem; font: 1rem/1.6 system-ui, sans-serif; border-radius: .4rem; padding: .7rem .85rem; border: 1px solid #879ba4; color: #182f3b; background: #fff; } .ds-input::placeholder { color: #586e78; } .ds-input:read-only { background: #eaf0f1; } .ds-input:user-invalid { border-color: #a12c2c; background: #fff4f3; } .ds-input:focus-visible { outline: 3px solid #147c94; outline-offset: 3px; }"
    },
